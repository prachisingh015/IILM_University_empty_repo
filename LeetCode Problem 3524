from typing import List

class Solution:
    def resultArray(self, nums: List[int], k: int) -> List[int]:
        result = [0] * k
        prev = [0] * k

        for num in nums:
            curr = [0] * k
            num %= k

            # Subarray containing only num
            curr[num] += 1

            # Extend every subarray ending at previous position
            for rem in range(k):
                if prev[rem]:
                    new_rem = (rem * num) % k
                    curr[new_rem] += prev[rem]

            # Add all subarrays ending here to final answer
            for rem in range(k):
                result[rem] += curr[rem]

            prev = curr

        return result
