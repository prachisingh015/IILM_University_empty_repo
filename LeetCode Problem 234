# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def isPalindrome(self, head: Optional[ListNode]) -> bool:
        if head is None or head.next is None:
            return True
        slow = head
        fast = head
        while fast is not None and fast.next is not None:
            slow = slow.next
            fast = fast.next.next
        prev = None
        curr = slow
        while curr is not None:
            next_node = curr.next
           # curr = next_node
            curr.next = prev
            prev = curr
            curr = next_node
        first = head
        second = prev
        while second is not None:
            if first.val is not second.val:
                return False
            first = first.next
            second = second.next
        return True 
